---
import { traductor, type Llengua } from "../i18n/ui";
import { dataISO, formataData, type Numero } from "../lib/posts";

interface Props {
  llengua: Llengua;
  numero: Numero;
}

const { llengua, numero } = Astro.props;
const t = traductor(llengua);
---

<li>
  <a class="fila-num" href={numero.url}>
    <span class="fila-numero">{t("num.abrev")} {String(numero.exemplar).padStart(2, "0")}</span>
    <span>
      <h3 class="fila-titol">{numero.entrada.data.title}</h3>
      <p class="fila-desc">{numero.entrada.data.description}</p>
    </span>
    <time class="fila-data" datetime={dataISO(numero.data)}>
      {formataData(numero.data, llengua)}
    </time>
  </a>
</li>
