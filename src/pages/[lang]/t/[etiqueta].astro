---
import PaginaEtiqueta from "../../../components/PaginaEtiqueta.astro";
import { LLENGUA_DEFECTE, type Llengua } from "../../../i18n/ui";
import { paginesEtiqueta, type Numero } from "../../../lib/posts";

export async function getStaticPaths() {
  const pagines = await paginesEtiqueta();
  return pagines
    .filter((p) => p.llengua !== LLENGUA_DEFECTE)
    .map(({ llengua, etiqueta, numeros, tambeA }) => ({
      params: { lang: llengua, etiqueta },
      props: { llengua, etiqueta, numeros, tambeA },
    }));
}

const { llengua, etiqueta, numeros, tambeA } = Astro.props as {
  llengua: Llengua;
  etiqueta: string;
  numeros: Numero[];
  tambeA: Llengua[];
};
---

<PaginaEtiqueta llengua={llengua} etiqueta={etiqueta} numeros={numeros} tambeA={tambeA} />
